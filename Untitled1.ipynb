    "\n",
    "import os\n",
    "import glob\n",
    "import pandas as pd\n",
    "from IPython.display import Audio, display, clear_output\n",
    "from natsort import natsorted  # استيراد دالة الترتيب الطبيعي\n",
    "\n",
    "# 1. جلب كل الملفات الصوتية وترتيبها ترتيباً رقمياً طبيعياً (1, 2, 3... 10)\n",
    "raw_audio_files = glob.glob(\"*.wav\")  # غيري الامتداد حسب ملفاتك\n",
    "audio_files = natsorted(raw_audio_files)\n",
    "\n",
    "data = []\n",
    "csv_file = \"metadata.csv\"\n",
    "\n",
    "# فحص الملف إذا كان موجوداً وغير فارغ\n",
    "if os.path.exists(csv_file) and os.path.getsize(csv_file) > 0:\n",
    "    try:\n",
    "        df_existing = pd.read_csv(csv_file)\n",
    "        done_files = set(df_existing[\"audio_file\"])\n",
    "        data = df_existing.to_dict('records')\n",
    "    except Exception:\n",
    "        done_files = set()\n",
    "else:\n",
    "    done_files = set()\n",
    "\n",
    "# تصفية الملفات المتبقية مع الحفاظ على الترتيب الطبيعي\n",
    "files_to_process = [f for f in audio_files if f not in done_files]\n",
    "\n",
    "print(f\"إجمالي الملفات: {len(audio_files)} | المتبقي للتفريغ: {len(files_to_process)}\\n\")\n",
    "print(\"تعليمات:\")\n",
    "print(\"- اكتب النص واضغط Enter للتنسيق والانتقال للمقطع التالي.\")\n",
    "print(\"- اكتب 'r' لإعادة تشغيل المقطع.\")\n",
    "print(\"- اكتب 'exit' للحفظ والخروج.\\n\" + \"=\"*40 + \"\\n\")\n",
    "\n",
    "for i, file_name in enumerate(files_to_process, 1):\n",
    "    while True:\n",
    "        print(f\"[{i}/{len(files_to_process)}] جاري تشغيل: {file_name}\")\n",
    "        \n",
    "        # عرض مشغل الصوت وتشغيله تلقائياً\n",
    "        display(Audio(file_name, autoplay=True))\n",
    "        \n",
    "        text = input(\"التفريغ النصي: \").strip()\n",
    "        \n",
    "        if text.lower() == 'r':\n",
    "            clear_output(wait=True)\n",
    "            continue\n",
    "        elif text.lower() == 'exit':\n",
    "            break\n",
    "        elif text == \"\":\n",
    "            print(\"⚠️ لم تكتب شيئاً! اكتب النص أو اكتب 'r' لإعادة التشغيل.\\n\")\n",
    "            continue\n",
    "        else:\n",
    "            data.append({\"audio_file\": file_name, \"transcription\": text})\n",
    "            # حفظ تلقائي بعد كل مقطع\n",
    "            pd.DataFrame(data).to_csv(csv_file, index=False, encoding=\"utf-8-sig\")\n",
    "            clear_output(wait=True)\n",
    "            break\n",
    "            \n",
    "    if text.lower() == 'exit':\n",
    "        print(\"\\nتم إيقاف العمل وتأمين الحفظ بنجاح.\")\n",
    "        break\n",
    "\n",
    "# حفظ نهائي\n",
    "if data:\n",
    "    df = pd.DataFrame(data)\n",
    "    df.to_csv(csv_file, index=False, encoding=\"utf-8-sig\")\n",
    "    print(f\"\\n🎉 تم الانتهاء! تم حفظ {len(df)} مقطع في ملف: {csv_file}\")"
